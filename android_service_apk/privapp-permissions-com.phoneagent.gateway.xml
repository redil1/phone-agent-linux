<?xml version="1.0" encoding="utf-8"?>
<permissions>
    <!--
      Reviewed privileged permissions required by the telephony audio spike.
      Runtime/dangerous permissions are still granted separately. Effective
      grants must be verified with dumpsys after every ROM update.
    -->
    <privapp-permissions package="com.phoneagent.gateway">
        <permission name="android.permission.CAPTURE_AUDIO_OUTPUT" />
        <permission name="android.permission.MODIFY_AUDIO_ROUTING" />
        <permission name="android.permission.MODIFY_PHONE_STATE" />
        <permission name="android.permission.CONTROL_INCALL_EXPERIENCE" />
    </privapp-permissions>
</permissions>

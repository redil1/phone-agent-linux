{
  "schema_version": 1,
  "policy_owner": "platform-security",
  "dependency_classes": {
    "python-runtime": {
      "owner": "voice-platform",
      "lock": "uv.lock",
      "update_method": "uv lock --upgrade-package <name>"
    },
    "python-development": {
      "owner": "developer-experience",
      "lock": "uv.lock",
      "update_method": "uv lock --upgrade-group dev"
    },
    "rust-sidecar": {
      "owner": "channel-platform",
      "lock": "whatsapp_channel/rust_caller/Cargo.lock",
      "update_method": "cargo update -p <name> --precise <version>"
    },
    "android-toolchain": {
      "owner": "device-platform",
      "lock": "security/dependency-policy.json",
      "update_method": "qualified toolchain change"
    },
    "container-base": {
      "owner": "platform-security",
      "lock": "Dockerfile.cuda digest",
      "update_method": "digest-only pull request"
    },
    "models": {
      "owner": "voice-ml",
      "lock": "release model manifest",
      "update_method": "quality, licence, security, and latency qualification"
    }
  },
  "supported_toolchains": {
    "python": [
      "3.11.13"
    ],
    "cuda": "12.9",
    "python_base": "3.11.13-slim-bullseye@sha256:9e25f400253a5fa3191813d6a67eb801ca1e6f012b3bd2588fa6920b59e3eba6",
    "debian_snapshot": "20250721T000000Z",
    "cuda_delivery": "hash-locked PyTorch cu129 wheels plus NVIDIA host driver injection",
    "pytorch": "2.13.0+cu129",
    "java": 17,
    "android_compile_sdk": 34,
    "android_build_tools": "34.0.0",
    "rust_minimum": "1.85.0",
    "uv": "0.12.9"
  },
  "update_cadence": {
    "scheduled_review_days": 14,
    "transitive_refresh_days": 30,
    "toolchain_review_days": 90,
    "emergency_security_updates": "event-driven",
    "required_evidence": [
      "lock diff",
      "CVE report",
      "licence report",
      "SBOM",
      "unit and integration tests",
      "latency and quality regression results for media or model changes",
      "rollback artifact"
    ]
  },
  "vulnerability_policy": {
    "critical_triage_hours": 24,
    "critical_remediation_hours": 72,
    "high_triage_hours": 72,
    "high_remediation_days": 14,
    "exception_maximum_days": 90,
    "exception_file": "security/dependency-audit-allowlist.json",
    "required_exception_fields": [
      "id",
      "aliases",
      "package",
      "affected_version",
      "owner",
      "expires",
      "justification"
    ],
    "audit_version_normalizations": {
      "torch": {
        "locked_version": "2.13.0+cu129",
        "advisory_version": "2.13.0",
        "reason": "The cu129 local label selects the binary build; upstream advisories identify the common PyTorch 2.13.0 source release."
      }
    }
  },
  "licence_policy": {
    "project_expression": "LicenseRef-Proprietary",
    "technical_allowlist": [
      "0BSD",
      "Apache-2.0",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "BSL-1.0",
      "ISC",
      "MIT",
      "MIT-0",
      "MPL-2.0",
      "PSF-2.0"
    ],
    "conditional_licences": [
      "LGPL-2.1-or-later",
      "LGPL-3.0-or-later",
      "LicenseRef-NVIDIA-SOFTWARE-LICENSE"
    ],
    "prohibited_without_written_legal_approval": [
      "AGPL-1.0-only",
      "AGPL-1.0-or-later",
      "AGPL-3.0-only",
      "AGPL-3.0-or-later",
      "GPL-2.0-only",
      "GPL-2.0-or-later",
      "GPL-3.0-only",
      "GPL-3.0-or-later",
      "LicenseRef-Evaluation-Only",
      "UNKNOWN"
    ],
    "rule": "Every shipped component must have an exact-version licence decision. Conditional or copyleft components require recorded distribution architecture, obligations, and written legal approval. Unknown and evaluation-only licences fail release.",
    "legal_boundary": "This is an engineering release policy, not legal advice. The product owner or qualified counsel records final commercial approval."
  },
  "system_components": [
